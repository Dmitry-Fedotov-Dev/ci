# Tool versions — the one place they are pinned. Read by lib/ci.sh (bin/ scripts), the
# Dockerfile (the cikit image) and the selftests; Renovate opens a PR when one is out of date
# (the "# renovate:" line above each tells it where to look).
# Not K6_* / XK6_*: k6 and xk6 read those names as their own options.

# renovate: datasource=go depName=golang.org/x/vuln
VER_GOVULNCHECK=v1.8.0
# renovate: datasource=go depName=github.com/securego/gosec/v2
VER_GOSEC=v2.29.0
# renovate: datasource=go depName=github.com/golangci/golangci-lint/v2
VER_GOLANGCI_LINT=v2.14.0
# renovate: datasource=go depName=gotest.tools/gotestsum
VER_GOTESTSUM=v1.13.0
# renovate: datasource=go depName=go.k6.io/xk6
VER_XK6=v1.4.14
# renovate: datasource=github-releases depName=grafana/k6
VER_K6=v2.3.0
# renovate: datasource=go depName=github.com/rhysd/actionlint
VER_ACTIONLINT=v1.7.12
# renovate: datasource=npm depName=gitlab-ci-local
VER_GITLAB_CI_LOCAL=4.76.0
