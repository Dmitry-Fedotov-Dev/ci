#!/usr/bin/env bash
# Dashboards edited through a generator script must match the committed JSON: run each
# generator into a temp file and compare.
#
#   bin/dashboards-sync <generator.py> <committed.json> [<generator.py> <committed.json>...]
#
# A generator is called as: python3 <generator.py> <output.json>.
set -euo pipefail
# shellcheck source=../lib/ci.sh
. "$(dirname "$0")/../lib/ci.sh"
[ $# -gt 0 ] && [ $(($# % 2)) = 0 ] || { ci_error dashboards-sync "usage: dashboards-sync <generator.py> <committed.json>..."; exit 2; }
ci_need python3
failed=0
while [ $# -gt 0 ]; do
  gen=$1 json=$2; shift 2
  tmp=$(mktemp --suffix=.json)
  python3 "$gen" "$tmp" >/dev/null
  if diff -q "$tmp" "$json" >/dev/null; then
    echo "in sync: $json"
  else
    ci_error dashboards-sync "$json differs from $gen output — regenerate it" "$json"
    failed=1
  fi
  rm -f "$tmp"
done
exit "$failed"
